# Agent 1 runner — cursor_agent_cli (default) or anthropic_api
# ANALYST_RUNNER=cursor_agent_cli

# --- cursor_agent_cli (default): cursor-agent -p, authenticated via `cursor-agent login`.
# Routes through Cursor's endpoints (not api.anthropic.com). ANTHROPIC_API_KEY is not used
# by this runner. Optional: point at a specific cursor-agent binary.
# CURSOR_AGENT_BIN=/path/to/cursor-agent

# --- anthropic_api: direct call to api.anthropic.com/v1/messages. No cursor-agent
# install/login needed. Requires an API key from console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...
# ANALYST_MAX_TOKENS=8192

# Agent 1 model + reasoning effort (defaults: claude-sonnet-5 / high). Effort applies to
# the cursor_agent_cli runner only — the Messages API has no bracket-style effort spec.
# ANALYST_MODEL=claude-sonnet-5
# ANALYST_EFFORT=high

JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=you@company.com
JIRA_API_TOKEN=your_api_token

# Comma-separated hosts allowed for /api/execute (loopback denied unless EXECUTOR_ALLOW_LOOPBACK=1)
EXECUTOR_ALLOWLIST=api.example.com,staging.example.com
# EXECUTOR_ALLOW_LOOPBACK=1
# EXECUTE_API_TOKEN=change-me
# EXECUTE_RATE_LIMIT=10
# EXECUTE_RATE_WINDOW_MS=60000

# Optional server tuning
# PORT=5173
# HOST=127.0.0.1
# MAX_BODY_BYTES=1048576
# JIRA_TIMEOUT_MS=15000
# EXECUTE_TIMEOUT_MS=15000
